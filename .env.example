# Enables client-side Sentry error reporting when set. Users still need to
# turn error reporting on in Settings > Privacy; leaving this unset disables
# Sentry entirely regardless of that setting.
VITE_SENTRY_DSN=

# Build-time only (do not prefix with VITE_): used by @sentry/vite-plugin to
# upload source maps to Sentry during production builds. Leave unset to skip
# the upload step, e.g. for local builds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Origin of the /api serverless functions (donation history). Must be absolute:
# the Android app runs on https://localhost and has no /api of its own.
VITE_PAYKY_API_BASE_URL=https://payky.me

# EET 2.0 production SOAP endpoint. Leave unset to offer only the playground.
VITE_PAYKY_EET_PRODUCTION_URL=

# Extra relays read (never written) for Nostr profiles, such as the support
# team's names in the support chat. Comma-separated.
VITE_PAYKY_NOSTR_PROFILE_RELAYS=wss://purplepag.es,wss://profiles.nostr1.com

# Server-only (do not prefix with VITE_): the support chat's team, served by
# /api/support-team so it changes with a deploy, no app release needed. Comma-separated npubs; when
# the team changes, append its line-up until then to the former teams (teams
# separated by ";", oldest first) so the app keeps showing that conversation.
# Every support member lists one of the relays as a DM relay in Amethyst.
PAYKY_SUPPORT_NPUBS=npub1ysdhhw8wx4ew4490mrfpd2gyv3w08rqudqp5pjasgn2kxduahuhstrqnll
PAYKY_SUPPORT_FORMER_TEAMS=
PAYKY_SUPPORT_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.0xchat.com,wss://nostr.linky.fit
