{
  "mcpServers": {
    "playwright": {
      "command": "bunx",
      "args": ["@playwright/mcp@latest"]
    },
    "chrome-devtools": {
      "command": "bunx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "reui": {
      "type": "http",
      "url": "https://mcp.reui.io/api/mcp"
    }
  }
}
