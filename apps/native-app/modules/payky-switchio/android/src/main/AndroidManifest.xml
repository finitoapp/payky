<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets isInstalled resolve the SwitchioPay ECR payment intent (package visibility, Android 11+). -->
  <queries>
    <intent>
      <action android:name="switchio.pay.ECR" />
      <data android:scheme="app" android:host="switchiopay" android:path="/api/main/v8/payment" />
    </intent>
  </queries>
</manifest>
