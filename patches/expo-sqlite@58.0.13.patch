diff --git a/android/CMakeLists.txt b/android/CMakeLists.txt
index cecd9c5d708e5708155990a88008289cb2d465a0..baae3d9b0cb899f6f5a3424f00f2a620e3392464 100644
--- a/android/CMakeLists.txt
+++ b/android/CMakeLists.txt
@@ -31,8 +31,9 @@ target_include_directories(
 find_library(LOG_LIB log)
 find_package(fbjni REQUIRED CONFIG)
 if(${USE_SQLCIPHER})
-  find_package(openssl REQUIRED CONFIG)
-  set(OPENSSL_CRYPTO_LIB "openssl::crypto")
+  # Payky patch: static OpenSSL, see build.gradle.
+  find_package(opensslstatic REQUIRED CONFIG)
+  set(OPENSSL_CRYPTO_LIB "opensslstatic::crypto")
 else()
   set(OPENSSL_CRYPTO_LIB "")
 endif()
@@ -44,3 +45,7 @@ target_link_libraries(
   fbjni::fbjni
   android
 )
+if(${USE_SQLCIPHER})
+  # Payky patch: keep the static OpenSSL's symbols out of the exports.
+  target_link_options(${PACKAGE_NAME} PRIVATE "-Wl,--exclude-libs,ALL")
+endif()
diff --git a/android/build.gradle b/android/build.gradle
index 70017463510f9549405888e2aba8835e5c8a3f6b..541275e4f561d97db6892bd7808308e2022b63ab 100644
--- a/android/build.gradle
+++ b/android/build.gradle
@@ -97,7 +97,12 @@ android {
 
 dependencies {
   if (project.ext.USE_SQLCIPHER) {
-    compileOnly 'io.github.ronickg:openssl:3.3.2-1'
+    // Payky patch: OpenSSL linked statically, as react-native-quick-crypto
+    // does (same artifact). A shared libcrypto.so loses to the system's on
+    // devices that make theirs public (PAX payment terminals list libcrypto.so
+    // in /system/etc/public.libraries.txt), whose BoringSSL lacks the OpenSSL
+    // 3 symbols SQLCipher needs (EVP_MAC_fetch), so the database never opened.
+    compileOnly 'io.github.ronickg:openssl-static:3.6.2-3'
   }
   compileOnly 'com.facebook.fbjni:fbjni:0.3.0'
 
